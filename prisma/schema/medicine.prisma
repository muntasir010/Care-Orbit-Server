model MedicineCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  icon      String?
  medicines Medicine[]
  createdAt DateTime   @default(now())

  @@map("medicine_categories")
}

model Medicine {
  id                   String     @id @default(uuid())
  name                 String
  genericName          String
  manufacturer         String
  description          String?
  strength             String? // e.g. "500mg"
  dosageForm           DosageForm @default(TABLET)
  packSize             String? // e.g. "10 tablets"
  price                Float
  discountPercent      Float      @default(0)
  stock                Int        @default(0)
  requiresPrescription Boolean    @default(false)
  image                String?
  isActive             Boolean    @default(true)
  isDeleted            Boolean    @default(false)
  categoryId           String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  category            MedicineCategory       @relation(fields: [categoryId], references: [id])
  cartItems           CartItem[]
  orderItems          MedicineOrderItem[]
  prescriptionEntries PrescriptionMedicine[]

  @@index([name])
  @@index([genericName])
  @@index([categoryId])
  @@map("medicines")
}

// ---------- Cart (PATIENT) ----------

model Cart {
  id        String     @id @default(uuid())
  patientId String     @unique
  updatedAt DateTime   @updatedAt
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  medicineId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@unique([cartId, medicineId])
  @@map("cart_items")
}

// ---------- Prescription upload (PATIENT uploads, ADMIN reviews) ----------

model PrescriptionUpload {
  id         String                   @id @default(uuid())
  patientId  String
  fileUrl    String
  status     PrescriptionUploadStatus @default(PENDING)
  reviewNote String?
  reviewedBy String? // admin email
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  patient Patient        @relation(fields: [patientId], references: [id])
  order   MedicineOrder?

  @@map("prescription_uploads")
}

// ---------- Doctor's prescription -> medicines (DOCTOR writes) ----------

model PrescriptionMedicine {
  id             String   @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String // "1 tablet"
  frequency      String // "3 times a day"
  duration       String // "7 days"
  instruction    String?
  createdAt      DateTime @default(now())

  prescriptions Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine      Medicine     @relation(fields: [medicineId], references: [id])

  @@unique([prescriptionId, medicineId])
  @@map("prescription_medicines")
}

// ---------- Orders (PATIENT places, ADMIN fulfils) ----------

model MedicineOrder {
  id              String                @id @default(uuid())
  orderNumber     String                @unique
  patientId       String
  status          MedicineOrderStatus   @default(PENDING)
  paymentStatus   MedicinePaymentStatus @default(UNPAID)
  subtotal        Float
  discount        Float                 @default(0)
  deliveryFee     Float                 @default(0)
  totalAmount     Float
  shippingName    String
  shippingPhone   String
  shippingAddress String
  note            String?
  transactionId   String?               @unique

  // optional links for prescription-required medicines
  prescriptionUploadId String? @unique
  prescriptionId       String? // doctor-issued Prescription

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient            Patient             @relation(fields: [patientId], references: [id])
  items              MedicineOrderItem[]
  prescriptionUpload PrescriptionUpload? @relation(fields: [prescriptionUploadId], references: [id])
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id])

  payment Payment?

  @@index([patientId])
  @@index([status])
  @@map("medicine_orders")
}

model MedicineOrderItem {
  id         String @id @default(uuid())
  orderId    String
  medicineId String
  name       String // snapshot
  quantity   Int
  unitPrice  Float // snapshot after discount
  lineTotal  Float

  order    MedicineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine      @relation(fields: [medicineId], references: [id])

  @@map("medicine_order_items")
}
